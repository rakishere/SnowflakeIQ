FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Snowflake connection. Copy this file to .env and fill in real values.
# Account identifier looks like orgname-accountname (no https, no .snowflakecomputing.com).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Authentication: fill in exactly one of the four options below.
# 1. Key pair: path to the private key file (.p8), plus its passphrase if encrypted.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
# 2. Programmatic access token (PAT) generated in Snowsight.
SNOWFLAKE_TOKEN=
# 3. Browser single sign-on: set to externalbrowser.
SNOWFLAKE_AUTHENTICATOR=
# 4. Password (Snowflake blocks password-only sign-in for most human users).
SNOWFLAKE_PASSWORD=

# Optional session context. Leave blank to use the user's defaults.
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Semantic view that Cortex Analyst answers questions from (DATABASE.SCHEMA.VIEW).
SNOWFLAKE_SEMANTIC_VIEW=
